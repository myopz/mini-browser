{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-browser",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
